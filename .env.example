CHRONOS_ENV=development
CHRONOS_LOG_LEVEL=info
CHRONOS_API_KEYS=dev-api-key-change-me
CHRONOS_WORKER_TOKENS=dev-worker-token-change-me
CHRONOS_POSTGRES_DSN=postgres://chronos:chronos@localhost:5432/chronos?sslmode=disable
CHRONOS_KAFKA_BROKERS=localhost:9092
CHRONOS_QUEUE_BACKEND=kafka
CHRONOS_QUEUE_KAFKA_TOPIC=chronos.jobs
